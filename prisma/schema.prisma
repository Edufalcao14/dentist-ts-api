generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               BigInt    @id @default(autoincrement())
  name             String
  address          String?
  cnpj             String?   @unique
  email            String?
  phone            String?
  stripeCustomerId String?   @map("stripe_customer_id")
  planType         String    @map("plan_type")
  planStatus       String    @map("plan_status")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  users        User[]
  patients     Patient[]
  services     Service[]
  appointments Appointment[]

  @@map("tenants")
}

model User {
  id          BigInt    @id @default(autoincrement())
  tenantId    BigInt    @map("tenant_id")
  firebaseUid String    @unique @map("firebase_uid")
  role        String
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phone       String?
  email       String
  birthdate   DateTime? @db.Date
  cpf         String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  dentist Dentist?
  patient Patient?

  @@map("users")
}

model Dentist {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @unique @map("user_id")
  croNumber      String?  @map("cro_number")
  specialization String?
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@map("dentists")
}

model Patient {
  id           BigInt    @id @default(autoincrement())
  tenantId     BigInt    @map("tenant_id")
  userId       BigInt    @unique @map("user_id")
  cpf          String?
  birthdate    DateTime? @db.Date
  allergies    Json?
  medicalNotes Json?     @map("medical_notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@map("patients")
}

model Service {
  id              BigInt    @id @default(autoincrement())
  tenantId        BigInt    @map("tenant_id")
  name            String
  code            String?
  price           Decimal   @db.Decimal(10, 2)
  durationMinutes Int       @map("duration_minutes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  appointmentServices AppointmentService[]

  @@map("services")
}

model Appointment {
  id          BigInt    @id @default(autoincrement())
  tenantId    BigInt    @map("tenant_id")
  patientId   BigInt    @map("patient_id")
  dentistId   BigInt    @map("dentist_id")
  dateTime    DateTime  @map("date_time")
  status      String
  notes       String?
  totalAmount Decimal?  @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id])
  dentist             Dentist              @relation(fields: [dentistId], references: [id])
  appointmentServices AppointmentService[]
  payments            Payment[]

  @@map("appointments")
}

model AppointmentService {
  id            BigInt   @id @default(autoincrement())
  appointmentId BigInt   @map("appointment_id")
  serviceId     BigInt   @map("service_id")
  quantity      Int
  notes         String?
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal     Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("appointment_services")
}

model Payment {
  id                     BigInt   @id @default(autoincrement())
  appointmentId          BigInt   @map("appointment_id")
  amount                 Decimal  @db.Decimal(10, 2)
  stripePaymentIntentId  String?  @map("stripe_payment_intent_id")
  status                 String
  paymentMethod          String?  @map("payment_method")
  createdAt              DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}
