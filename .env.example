# Application Configuration
# Application environment: prod | dev | qa (defaults from NODE_ENV if unset)
APP_ENV=dev
NODE_ENV=development
PORT=3001

# CORS (comma-separated; required in production)
ALLOWED_ORIGINS=

# Global API rate limit (requests per 15 min per IP)
API_RATE_LIMIT_MAX=100

# Database Configuration (for Docker Compose)
POSTGRES_PORT=5432
POSTGRES_USER=db_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=cdesign_db

# Database URL (for local development without Docker)
# When using Docker Compose, this is automatically constructed from the POSTGRES_* variables above
# When running locally, provide your database connection string here
DATABASE_URL=postgresql://db_user:your_secure_password_here@localhost:5432/cdesign_db?schema=public

# Firebase (IAM Gateway)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cloudinary (Media Gateway)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
